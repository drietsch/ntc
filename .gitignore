/target
**/*.rs.bk
Cargo.lock.orig

# Python
__pycache__/
*.pyc
.venv/
uv.lock.orig
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Data & runs (large artifacts stay out of git)
# Third-party source corpora: large, and licensed for use but not for
# redistribution here (see NOTICE). Place them in the repo root manually.
/salesforce-training-data.json
/glaive-function-calling-v2.json

# Derived / bulk corpora are regenerable — see training/README.md.
training/data/*
# ...but the curated Pimcore sets ARE tracked: the live teacher shards cost
# real `claude -p` calls and would come back different on a rerun, and the
# DELEGATE templates are hand-authored.
!training/data/live/
!training/data/delegate/
!training/data/pimcore/
training/runs/
wandb/
*.safetensors
*.ckpt

# Editor
.DS_Store
.idea/
.vscode/

# Built wasm bundle (regenerate with examples/browser/build.sh)
examples/browser/pkg/

# Regenerable eval batch inputs (the dataset generator is deterministic)
models/*/eval/*.input.jsonl

# The any-word model is 89 MB — rebuild locally instead of committing:
#   cd training && uv run python -m tools.prune_backbone && uv run python -m tools.merge_data \
#   && uv run python train.py --arch backbone --init runs/backbone/init.pt --data data/any --out runs/any-v1 --epochs 25 \
#   && uv run python -m export.export_mini --ckpt runs/any-v1/best.pt --out ../models/ntc-any-v1/model.ntc --version ntc-any-v1 --tokenizer-dir tokenizer-any
models/ntc-any-v1/model.ntc
models/ntc-pimcore-v1/model.ntc
# Trained Studio router (87 MB). Rebuild:
#   cd training && uv run python -m tools.convert_studio --max-candidates 3 \
#     && uv run python train.py --arch studio --init runs/backbone/init.pt \
#        --data data/studio --out runs/studio-v1 --epochs 5 --batch 12 --lr 2e-4 \
#     && uv run python -m export.export_mini --ckpt runs/studio-v1/best.pt \
#        --out ../models/ntc-studio-v1/model.ntc --version ntc-studio-v1 \
#        --tokenizer-dir tokenizer-any
models/ntc-studio-v1/model.ntc
# Studio v4 (91 MB): v3 warm-started on the corpus plus the 446 "the thing you
# want to act on is not here" ASK rows. Rebuild:
#   cd training && uv run python -m tools.add_source_absent --src data/studio-neg --out data/studio-ask \
#     && uv run python train.py --arch studio --init <v3-final.pt> --data data/studio-ask \
#        --out runs/studio-v4 --epochs 10 --batch 12 --lr 2e-4 --backbone-lr 1e-4 \
#     && eval/run_all.sh "$PWD/runs/studio-v4/best.pt" ntc-studio-v4
models/ntc-studio-v4/model.ntc
models/ntc-studio-v3-rerun/model.ntc
# Studio v5 (91 MB): v3 warm-started on the template corpus WITHOUT v4's ASK
# rows, so the head-codec v4 mechanism is the only variable against v3. Rebuild:
#   cd training && uv run python -m tools.add_value_templates --src data/studio-neg --out data/studio-tpl-neg \
#     && uv run python train.py --arch studio --init <v3-final.pt> --data data/studio-tpl-neg \
#        --out runs/studio-v5 --epochs 10 --batch 12 --lr 2e-4 --backbone-lr 1e-4 \
#     && eval/run_all.sh "$PWD/runs/studio-v5/best.pt" ntc-studio-v5 \
#        examples/pimcore-tools-templates.json training/data/studio-tpl-neg/dev.jsonl
models/ntc-studio-v5/model.ntc
