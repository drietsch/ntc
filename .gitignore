/target
**/*.rs.bk
Cargo.lock.orig

# Python
__pycache__/
*.pyc
.venv/
uv.lock.orig
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Data & runs (large artifacts stay out of git)
# Third-party source corpora: large, and licensed for use but not for
# redistribution here (see NOTICE). Place them in the repo root manually.
/salesforce-training-data.json
/glaive-function-calling-v2.json

# Derived / bulk corpora are regenerable — see training/README.md.
training/data/*
# ...but the curated Pimcore sets ARE tracked: the live teacher shards cost
# real `claude -p` calls and would come back different on a rerun, and the
# DELEGATE templates are hand-authored.
!training/data/live/
!training/data/delegate/
!training/data/pimcore/
training/runs/
wandb/
*.safetensors
*.ckpt

# Editor
.DS_Store
.idea/
.vscode/

# Built wasm bundle (regenerate with examples/browser/build.sh)
examples/browser/pkg/

# Regenerable eval batch inputs (the dataset generator is deterministic)
models/*/eval/*.input.jsonl

# The any-word model is 89 MB — rebuild locally instead of committing:
#   cd training && uv run python -m tools.prune_backbone && uv run python -m tools.merge_data \
#   && uv run python train.py --arch backbone --init runs/backbone/init.pt --data data/any --out runs/any-v1 --epochs 25 \
#   && uv run python -m export.export_mini --ckpt runs/any-v1/best.pt --out ../models/ntc-any-v1/model.ntc --version ntc-any-v1 --tokenizer-dir tokenizer-any
models/ntc-any-v1/model.ntc
models/ntc-pimcore-v1/model.ntc
