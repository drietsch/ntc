{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompileOutcome",
  "description": "The compiler's public result (spec §3, V1 action subset).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "call",
        "ir",
        "outcome"
      ],
      "properties": {
        "call": {
          "$ref": "#/definitions/CompiledCall"
        },
        "ir": {
          "$ref": "#/definitions/ActionIr"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "CALL"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ir",
        "outcome",
        "unresolved"
      ],
      "properties": {
        "ir": {
          "$ref": "#/definitions/ActionIr"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ASK"
          ]
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UnresolvedField"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ir",
        "outcome"
      ],
      "properties": {
        "ir": {
          "$ref": "#/definitions/ActionIr"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "NO_CALL"
          ]
        }
      }
    },
    {
      "description": "Beyond a single typed call — the host should hand `utterance` to a full LLM agent (which may use the same tools over several turns).",
      "type": "object",
      "required": [
        "candidates",
        "ir",
        "outcome",
        "utterance"
      ],
      "properties": {
        "candidates": {
          "description": "Registry ids offered to the router, so the host can pass the same candidate set to the agent.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ir": {
          "$ref": "#/definitions/ActionIr"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "DELEGATE"
          ]
        },
        "utterance": {
          "type": "string"
        }
      }
    }
  ],
  "definitions": {
    "ActionIr": {
      "description": "The typed action program produced by the neural compiler and consumed by the deterministic backend.",
      "type": "object",
      "required": [
        "action",
        "action_confidence",
        "ir_version"
      ],
      "properties": {
        "action": {
          "$ref": "#/definitions/ActionState"
        },
        "action_confidence": {
          "description": "Calibrated confidence of the action-state decision, in `[0, 1]`.",
          "type": "number",
          "format": "float"
        },
        "arguments": {
          "description": "Bound arguments; non-empty only for `CALL`.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArgumentBinding"
          }
        },
        "delegate_reason": {
          "description": "Present iff `action == DELEGATE`: why the router escalated.",
          "anyOf": [
            {
              "$ref": "#/definitions/DelegateReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "ir_version": {
          "description": "Always [`crate::IR_VERSION`] for values produced by this crate.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "no_call_reason": {
          "description": "Present iff `action == NO_CALL`.",
          "anyOf": [
            {
              "$ref": "#/definitions/NoCallReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_tool": {
          "description": "Optional hint for the agent: the tool the router believes is involved (it just could not compile the call itself).",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "Present iff `action == CALL`.",
          "anyOf": [
            {
              "$ref": "#/definitions/ToolSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved": {
          "description": "Fields the model could not resolve; drives `ASK`.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/UnresolvedField"
          }
        }
      },
      "additionalProperties": false
    },
    "ActionState": {
      "description": "V1 action states (spec §73) plus [`ActionState::Delegate`].\n\n`DELEGATE` is the router's escape hatch: the request is real work, but not work a single typed call can express — a multi-step chain whose later steps depend on earlier *results*, a bulk mutation over an unknown result set, conditional/comparative logic, or open-ended authoring/reasoning. The host hands such utterances to a full LLM agent (which may itself use the same tools). It is deliberately distinct from `NO_CALL` (\"nothing to execute here\") and from `ASK` (\"one missing argument away from a call\").\n\nModels trained before this variant existed emit 3-class action logits; `NtcArchConfig::action_classes` records the width, so old `.ntc` files keep loading and simply never predict `DELEGATE`.",
      "type": "string",
      "enum": [
        "CALL",
        "ASK",
        "NO_CALL",
        "DELEGATE"
      ]
    },
    "ArgumentBinding": {
      "description": "A semantic value as predicted by the model — richer than JSON types so deterministic code can canonicalize exactly (spec §19).\n\nWire shape (adjacent tagging) matches spec §18: `{ \"semantic_type\": \"DURATION\", \"value\": { \"magnitude\": 1, \"unit\": \"HOUR\" } }`",
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "STRING"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "BOOLEAN"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "INTEGER"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "FLOAT"
              ]
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Index + symbol into the canonical schema's enum-value list for the bound parameter. `index` is authoritative; `symbol` is redundancy the validator cross-checks.",
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "ENUM"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "index",
                "symbol"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "symbol": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "ABSOLUTE_DATE"
              ]
            },
            "value": {
              "$ref": "#/definitions/CivilDate"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "RELATIVE_DATE"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "relation"
              ],
              "properties": {
                "offset": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/DurationValue"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "relation": {
                  "$ref": "#/definitions/DateRelation"
                },
                "weekday": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Weekday"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "description": "RFC 3339 timestamp, e.g. `2026-08-19T15:00:00+02:00`.",
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "ABSOLUTE_DATETIME"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "RELATIVE_DATETIME"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "relation"
              ],
              "properties": {
                "daypart": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Daypart"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "offset": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/DurationValue"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "relation": {
                  "$ref": "#/definitions/DateRelation"
                },
                "time": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/CivilTime"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "weekday": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Weekday"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "TIME_OF_DAY"
              ]
            },
            "value": {
              "$ref": "#/definitions/CivilTime"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "DAYPART"
              ]
            },
            "value": {
              "$ref": "#/definitions/Daypart"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "DURATION"
              ]
            },
            "value": {
              "$ref": "#/definitions/DurationValue"
            }
          }
        },
        {
          "description": "Person reference by surface text in V1 (no context-entity resolution).",
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "PERSON_REF"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "LOCATION"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "description": "Spec §19 `LIST<T>`: a homogeneous list of scalar values.\n\nElements are flat values under a single declared `item_type` (matching the ABI's `ITEM <TYPE>` line) rather than individually tagged values — a list is homogeneous by construction, so tagging every element repeats the schema. Elements may come from one span the runtime splits deterministically, or from several linked items, so `element_provenance` records per-element origin when it differs from the argument's own.",
          "type": "object",
          "required": [
            "semantic_type",
            "value"
          ],
          "properties": {
            "semantic_type": {
              "type": "string",
              "enum": [
                "LIST"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "item_type",
                "items"
              ],
              "properties": {
                "element_provenance": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Provenance"
                  }
                },
                "item_type": {
                  "$ref": "#/definitions/ListItemType"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ListItem"
                  }
                }
              }
            }
          }
        }
      ],
      "required": [
        "confidence",
        "parameter"
      ],
      "properties": {
        "confidence": {
          "description": "Calibrated confidence of this binding, in `[0, 1]`.",
          "type": "number",
          "format": "float"
        },
        "parameter": {
          "description": "Parameter name as declared in the canonical tool schema.",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CivilDate": {
      "type": "object",
      "required": [
        "day",
        "month",
        "year"
      ],
      "properties": {
        "day": {
          "description": "1–31",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "month": {
          "description": "1–12",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "year": {
          "type": "integer",
          "format": "int16"
        }
      },
      "additionalProperties": false
    },
    "CivilTime": {
      "type": "object",
      "required": [
        "hour",
        "minute"
      ],
      "properties": {
        "hour": {
          "description": "0–23",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "minute": {
          "description": "0–59",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "CompiledCall": {
      "description": "A validated, executable tool call (spec §4 backend output).",
      "type": "object",
      "required": [
        "arguments",
        "name"
      ],
      "properties": {
        "arguments": true,
        "name": {
          "type": "string"
        }
      }
    },
    "DateRelation": {
      "description": "Fixed vocabulary of relative-date relations. Index assignments (for the datetime head) live in the head codec; this enum is the IR-side vocabulary.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "TODAY",
            "TOMORROW",
            "YESTERDAY"
          ]
        },
        {
          "description": "e.g. \"this Friday\"",
          "type": "string",
          "enum": [
            "THIS"
          ]
        },
        {
          "description": "e.g. \"next Friday\"",
          "type": "string",
          "enum": [
            "NEXT"
          ]
        },
        {
          "description": "e.g. \"last Friday\"",
          "type": "string",
          "enum": [
            "LAST"
          ]
        },
        {
          "description": "e.g. \"in 3 days\" — magnitude/unit in `offset`",
          "type": "string",
          "enum": [
            "IN"
          ]
        },
        {
          "description": "e.g. \"3 days ago\" — magnitude/unit in `offset`",
          "type": "string",
          "enum": [
            "AGO"
          ]
        }
      ]
    },
    "Daypart": {
      "type": "string",
      "enum": [
        "MORNING",
        "NOON",
        "AFTERNOON",
        "EVENING",
        "NIGHT"
      ]
    },
    "DelegateReason": {
      "description": "Why a request is handed to a full LLM agent. The router does not just say \"not mine\" — it says *why*, so the host can route (a payload builder, a batching loop, a planner) and so failures are diagnosable.",
      "oneOf": [
        {
          "description": "The call needs a nested object/array payload the structured heads cannot author (`propose_*`, `update_*`).",
          "type": "string",
          "enum": [
            "PAYLOAD_REQUIRED"
          ]
        },
        {
          "description": "A single intent exceeding a hard per-call cap (max 5 elements, max 20 proposals, page-size limits) — needs a loop.",
          "type": "string",
          "enum": [
            "OVER_LIMIT"
          ]
        },
        {
          "description": "Conjunctive or genuinely chained request.",
          "type": "string",
          "enum": [
            "MULTI_STEP"
          ]
        },
        {
          "description": "The selection spans element types a single-type tool cannot accept.",
          "type": "string",
          "enum": [
            "MIXED_ELEMENT_TYPES"
          ]
        }
      ]
    },
    "DurationUnit": {
      "type": "string",
      "enum": [
        "SECOND",
        "MINUTE",
        "HOUR",
        "DAY",
        "WEEK"
      ]
    },
    "DurationValue": {
      "type": "object",
      "required": [
        "magnitude",
        "unit"
      ],
      "properties": {
        "magnitude": {
          "type": "number",
          "format": "double"
        },
        "unit": {
          "$ref": "#/definitions/DurationUnit"
        }
      },
      "additionalProperties": false
    },
    "ListItem": {
      "description": "One element of a `LIST`.",
      "anyOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "ListItemType": {
      "description": "Element type of a `LIST` value (scalars only, mirroring the ABI).",
      "type": "string",
      "enum": [
        "STRING",
        "INTEGER",
        "FLOAT",
        "BOOLEAN"
      ]
    },
    "NoCallReason": {
      "description": "Why nothing should be executed.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "CHITCHAT",
            "CONCEPTUAL_QUESTION",
            "UNSUPPORTED_CAPABILITY",
            "OUT_OF_SCOPE"
          ]
        },
        {
          "description": "The utterance names a tool but only discusses it.",
          "type": "string",
          "enum": [
            "MENTION_ONLY"
          ]
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "linked_refs": {
          "description": "Refs into `CompileRequest.context.linked` (e.g. `[\"L1\", \"L3\"]`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolver_token": {
          "description": "The identifier token the host's resolver looked up.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/ProvenanceSource"
        },
        "token_span": {
          "description": "`[start, end)` token indices over the tokenized utterance.",
          "anyOf": [
            {
              "$ref": "#/definitions/TokenSpan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ProvenanceSource": {
      "description": "Where a bound value came from.",
      "oneOf": [
        {
          "description": "Extracted from the user utterance (span points into its tokens).",
          "type": "string",
          "enum": [
            "USER"
          ]
        },
        {
          "description": "Bound from an item the user linked into the chat (Studio selection); `linked_refs` names which one(s).",
          "type": "string",
          "enum": [
            "LINKED_ITEM"
          ]
        },
        {
          "description": "Resolved by the host's identifier pre-pass; `resolver_token` names the token that was looked up.",
          "type": "string",
          "enum": [
            "RESOLVER"
          ]
        },
        {
          "description": "Resolved from conversational context entities.",
          "type": "string",
          "enum": [
            "CONTEXT"
          ]
        },
        {
          "description": "Constructed by the model with no source in the request (a PQL string, a default parent id).",
          "type": "string",
          "enum": [
            "MODEL"
          ]
        }
      ]
    },
    "TokenSpan": {
      "type": "object",
      "required": [
        "end",
        "start"
      ],
      "properties": {
        "end": {
          "description": "Exclusive.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ToolSelection": {
      "type": "object",
      "required": [
        "candidate_index",
        "confidence",
        "registry_id"
      ],
      "properties": {
        "candidate_index": {
          "description": "Index into the candidate set given to the model (0..15 in V1).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "confidence": {
          "description": "Calibrated confidence of the tool selection, in `[0, 1]`.",
          "type": "number",
          "format": "float"
        },
        "registry_id": {
          "description": "Stable registry id of the selected tool, e.g. `calendar.create`.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "UnresolvedField": {
      "type": "object",
      "required": [
        "confidence",
        "parameter",
        "reason"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "hint": {
          "description": "Machine-readable cause, so the host can phrase the question (e.g. `TWO_LINKED_ITEMS_OF_DIFFERENT_TYPE`).",
          "type": [
            "string",
            "null"
          ]
        },
        "parameter": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/UnresolvedReason"
        }
      },
      "additionalProperties": false
    },
    "UnresolvedReason": {
      "description": "Why an argument could not be filled (spec §16.3).\n\n`MISSING`/`AMBIGUOUS` are the V1 pair; the rest name failure modes a host with a selection frame and an identifier resolver can actually hit, so it can phrase a useful question instead of a generic one.",
      "oneOf": [
        {
          "description": "Nothing in the utterance or context supplies it.",
          "type": "string",
          "enum": [
            "MISSING"
          ]
        },
        {
          "description": "Several readings are equally good (two linked items of different type).",
          "type": "string",
          "enum": [
            "AMBIGUOUS"
          ]
